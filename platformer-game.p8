-- main functions

function game_init()
--location of levels on map
--6 or 40
	--music(39,0,5)

	levels = {
	{0,17,"x1"},
	{16,17,"x2"},
	{33,17,"x2"},
	{49,17,"x3"},
	{64,17,"x3"},
	{81,17,"x3"},
	{97,17,"x3"},
	
	{0,34,"x3"},
	{17,34,"x3"},
	{33,34,"x3"},
	{49,34,"x3"},
	{65,34,"x3"},
	{81,34,"x3"},
	{97,34,"x3"},
	
	
	
	}
	
	p_locations = {
	{0,17},
	{5,60},
	{0,50},
	{0,40},
	{20, 20},
	{0, 40},
	{10, 40},
	
	{0, 40},
	{10, 40},
	{10, 40},
	{0, 40},
	{3, 40},
	{0, 40},
	{0, 40},
	}
	
--level struct	
	level = {
		x = 0,
		y = 17,
		name = "x1"
	}
	
--level number
	levelnum = 1
	init_player(40,50)
	map_x = 0
	map_y = 17
	
--light vs dark
	light_tile = 81
	dark_tile = 65
	cover = 68
	light = false
	init_parallax()


end

function game_update()
	
	
	update_player()
	update_parallax()
	
	text_update()
	
	if levelnum > 7 then
	light = true
	
	end
	
	if switch(p.x,p.y+8) or 
				switch(p.x+7, p.y+8) then
				if light then
				set_all1(light_tile,dark_tile)
				end
	else
			if not light then
				set_all1(dark_tile,light_tile)
				end
	end
	
	
	if btnp(❎) then
	-- switch
		if light then
			set_all1(light_tile,dark_tile)
		else
			set_all1(dark_tile,light_tile)
		end
	end
	
--camera update-------------
	cx = ((p.x-64)+(cx*9)) /10
	if (cx < 0 ) cx = 0
	
--completed level----------
	if level_finished(p.x+7,p.y) then
		next_level()
	end
		
--if player off screen
--reset player
	 checkbounds()


end


function game_draw()
	cls()
 rectfill(0,0,128,128,0)
 map(104,1,10,14,2,2)
 draw_parallax()
 
	camera(cx,cy)
	map(map_x,map_y)
	draw_player()
	text_draw() 
--	print("move",45,42,1)
	--print("move",53,100,1)
	if levelnum ==1 then
		print("move",12,115,1)
	end
	if levelnum ==2 then
	print("jump",12,90,1)
	end

	


	
	if mode=="levelover" then
-- draw_levelover() - dont need
	end
	
	--camera()
	--print("light="..tostr(light),1,1,7)

end









