--game helper

function draw_gamveover()
	rectfill(100,37,128,75,7)
	print("game over", 46, 62,7)
	print("press ❎ to restart", 27)
end



--level restart---------------
function checkbounds()
	
	if levelnum <= 7 then
		if p.y >= 120 then	
					spawn()
			end
	else
		if p.y >= 109 then
				spawn()
			end
	end
end

function next_level()

	if levelnum ==1 then
	levelnum = 1
	end
	

	levelnum +=1
	if levelnum ==	8 then
	music(50,0,5)
	end
	
	if levelnum ==	12 then
	music(16,0,5)
	end
	if levelnum > 15 then
	-- endgame 
	else
--update to next level------
		
		level.x = levels[levelnum][1]
		level.y = levels[levelnum][2]
		level.name = levels[levelnum][3]
		
		p.x = p_locations[levelnum][1]
		p.y = p_locations[levelnum][2]
		map_x = level.x
		map_y = level.y
	end
end

--collision checks----------
function col(x,y)
		return fget(
			mget(map_x + x/8, map_y + y/8),0
		) 
end

function col_hazard(x,y)
		return fget(
			mget(map_x + x/8, map_y + y/8),7
		) 
end

--switch world block----------
function switch(x,y)

		return fget(
			mget(map_x + x/8, map_y + y/8),3
		) 
end

--level finished flag check---
function level_finished(x,y)

	return fget(
		mget(map_x + x/8, map_y + y/8),2
	)
end

function spawn()
		p.x = p_locations[levelnum][1]
		p.y = p_locations[levelnum][2]


end
function respawn(x,y)

	return fget(
		mget(map_x + x/8, map_y + y/8),3
	)
end

function set_all1(old,new)
	for y = level.y,level.y +15 do
  for x = level.x,level.x+15 do
   -- show the new tiles that were covered
   if mget(x,y) == cover then
      mset(x,y,new) 
   end
   --cover the current tiles
   if mget(x,y) == old then
      mset(x,y,cover)
      
   end 
   if respawn(x,y) then
   			startx = x
   			starty = y
      
   end
   
  end
	end
	light = not light
	
end



--title screen---

function title()
 map_size_x = 63
 map_size_y = 21
 local i
 local j
 local title_index = 1
 for j = 19, map_size_y-1 do
 	for i = 52, map_size_x-1 do
 		if j > 19 and i == 62 then
 		
 		else
 		mset(i,j,title_cover_list[title_index])	
 		title_index += 1
 		end
 	end
 end      
end

function title_cov()

title_cover_list ={}
for title_col = 1, 3 do
	 		for title_start = 0,
	 		10 do
	 			if title_col == 1 then
	 				titlenum = 214
	 			else
	 				titlenum = 230
	 			end
 				title_cover = 
 				title_start + titlenum
 	 
 				add(title_cover_list, title_cover)
 				
 			
 end
end

end
