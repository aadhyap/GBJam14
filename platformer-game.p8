--splash screen

function intro()
 t=0
 palt(11,true)
 sfx(1)
 
 while (t<120) do
 	color(3)
  print("onian",54,64)
  color(0)
  rectfill(48+(-525+t*10),63,
  80,69)
  t=(t+3)%155
  flip()
  cls(0)
 end
 
 t = 0
 
 while (t < 50) do
 	color(3)
 	print("onian",54,64)
 	flip()
 	cls(0)
 	t += 1
 end
 
end
