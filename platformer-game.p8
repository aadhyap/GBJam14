--init file

function _init()
--	intro()
	state = "menu"
end

function _update()

	if state == "menu" then
		menu_update()
	end
	
	if state == "game" then
		game_update()
	end
end

function _draw()
	if state == "menu" then
		menu_draw()
	end
	
	if state == "game" then
		game_draw()
	end

end
