--game helper

function draw_gamveover()
	rectfill(0,60,128,75,0)
	print("game over", 46, 62,7)
	print("press ❎ to restart", 27)
end

function draw_levelover()
	rectfill(0,60,128,75,0)
	print("stage clear", 46, 62,7)
	print("press ❎ to continue",27,68,6)
	
end

--level restart---------------
function checkbounds()
	
	if levelnum < 7 then
		if p.y >= 120 then	
					spawn()
			end
	else
		if p.y >= 115 then
				spawn()
			end
	end
end

function next_level()

	if levelnum ==1 then
	levelnum = 6
	end
	levelnum +=1
	if levelnum > 15 then
	-- endgame 
	else
--update to next level------
		
		level.x = levels[levelnum][1]
		level.y = levels[levelnum][2]
		level.name = levels[levelnum][3]
		
		p.x = p_locations[levelnum][1]
		p.y = p_locations[levelnum][2]
		map_x = level.x
		map_y = level.y
	end
end

--collision checks----------
function col(x,y)
		return fget(
			mget(map_x + x/8, map_y + y/8),0
		) 
end

function col_hazard(x,y)
		return fget(
			mget(map_x + x/8, map_y + y/8),7
		) 
end

--switch world block----------
function switch(x,y)

		return fget(
			mget(map_x + x/8, map_y + y/8),3
		) 
end

--level finished flag check---
function level_finished(x,y)

	return fget(
		mget(map_x + x/8, map_y + y/8),2
	)
end

function spawn()
		p.x = p_locations[levelnum][1]
		p.y = p_locations[levelnum][2]


end
function respawn(x,y)

	return fget(
		mget(map_x + x/8, map_y + y/8),3
	)
end

function set_all1(old,new)
	for y = level.y,level.y +15 do
  for x = level.x,level.x+15 do
  
   -- show the new tiles that were covered
   if mget(x,y) == cover then
      mset(x,y,new) 
   end
   
   --cover the current tiles
   if mget(x,y) == old then
      mset(x,y,cover)
      
   end 
   
   if respawn(x,y) then
   			startx = x
   			starty = y
      
   end
   
  end
	end
	light = not light
end



