--game helper

function draw_gamveover()
	rectfill(0,60,128,75,0)
	print("game over", 46, 62,7)
	print("press ❎ to restart", 27)
	
end

function draw_levelover()
	rectfill(0,60,128,75,0)
	print("stage clear", 46, 62,7)
	print("press ❎ to continue",27,68,6)
	
end

function next_level()

	levelnum +=1
	
	if levelnum > 2 then
	
	-- endgame 
	
	else
--update to next level------
		sfx(6)
		level.x = levels[levelnum][1]
		level.y = levels[levelnum][2]
		level.name = levels[levelnum][3]
		 
		p.x = level.x
		p.y = level.y
		map_x = level.x
		map_y = level.y
	end
end

--collision checks----------
function col(x,y)
		return fget(
			mget(map_x + x/8, map_y + y/8),0
		) 
end

--level finished flag check---
function level_finished(x,y)
	return fget(
		mget(x/8, y/8),1
	)
end
-->8
--splash screen

function intro()
 t=0
 palt(11,true)
 sfx(1)
 
 while (t<120) do
 	color(3)
  print("onian",54,64)
  color(0)
  rectfill(48+(-525+t*10),63,
  80,69)
  t=(t+3)%155
  flip()
  cls(0)
 end
 
 t = 0
 
 while (t < 50) do
 	color(3)
 	print("onian",54,64)
 	flip()
 	cls(0)
 	t += 1
 end
 
end
