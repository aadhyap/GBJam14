	locn = 8
		
elseif levelnum == 14 then
	npc_exist = true
	animatenpc(12, 
	14, 0.1)
	locn = 9
		
else
npc_exist = false
	
end


-- flip npc
if npc_exist then
	npc_x =  npc_loc[locn][1]
	npc_y =  npc_loc[locn][2] 
	if p.x <= npc_x and levelnum != 14 then
			flipped_npc = true
		else
			flipped_npc = false
	end

end 

end


function draw_npc()

if npc_exist and levelnum >= 5 and levelnum < 15  then
spr(framenpc,npc_x,npc_y,1,1,flipped_npc)
end 




 

end



function animatenpc(startnpc, 
end_framenpc, speednpc)


--animation------------------
	if framenpc<startnpc then
	 framenpc = startnpc
	end
		if framenpc < end_framenpc - speednpc
	 then
			framenpc+=speednpc
		else
			framenpc=startnpc
		end
		
	
end
