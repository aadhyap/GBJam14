--parallax
function init_parallax()
 --tables to hold map pieces
 map_bg={} --bg layer 1
 map_mg={} --mg layer 2
 map_fg={} --fg layer 3
 for i=0,1 do
   spawn_map(i*128,0,1)
   spawn_map(i*128,0,2)
   spawn_map(i*128,0,3)
 end
end
function update_parallax()
 foreach(map_bg,update_map)
 foreach(map_mg,update_map)
 foreach(map_fg,update_map)
end

function draw_parallax()
 foreach(map_bg,draw_map)
 foreach(map_mg,draw_map)
 foreach(map_fg,draw_map)
end

function update_map(m)
 m.x-=m.l/2  --move map to left

 --if map off edge of screen
 if m.x<-128 then
  if m.l==1 then
      del(map_bg,m) --delete map
  end
  if m.l==2 then
      del(map_mg,m) --delete map
  end
  if m.l==3 then
      del(map_fg,m)
  end
  --add new map to right
  spawn_map(16*8,0,m.l)
 end
end

function spawn_map(x,y,l)
 local m={}
 m.x=x
 m.y=y
 m.l=l
 
 --add map bit to correct layer
 if l==1 then
     add(map_bg,m)
 end
 if l==2 then
     add(map_mg,m)
 end
 if l==3 then
     add(map_fg,m)
 end
end

function draw_map(m)

	
	if light then
	 if m.l==1 then
	  map(49,0,m.x,m.y,16,16)
	 end
	 if m.l==2 then
	  map(54,0,m.x,m.y,16,16)
	 end
	 if m.l==3 then
	  map(70,0,m.x,m.y,16,16)
	 end
	 map(99,1,10,14,2,2)
	else
	if m.l==1 then
	     map(0,0,m.x,m.y,16,16)
	 end
	 if m.l==2 then
	     map(16,0,m.x,m.y,16,16)
	 end
	 if m.l==3 then
	     map(32,0,m.x,m.y,16,16)
	 end
		
		
	
	
	end
end
