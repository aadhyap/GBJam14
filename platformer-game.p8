-- player functions

function init_player(srt_x, srt_y)
	p = {
		x =srt_x,
		y =srt_y,
		dx = 0,
		dy = 0,
		g = false,
		flipped = false,
		j_buffer = 0
	}
	frame=1
	gravity = 1.5
	black = true
	
	
end

function update_player()
	local input_x
 local input_j



--move buttons----------------
	if (btn(⬅️)) or (btn(➡️)) then
		land = false
		if not up then
			animate(7,9,0.2)
		end
		if (btn(⬅️)) then
			p.flipped = true
			p.dx -= 0.2
			input_x = -1
		else
			p.flipped = false
			p.dx += 0.2
			input_x = 1
		end
	else 
	input_x = 0
	end
	
	if btnp(⬆️) or btnp(🅾️) then
		up =true and not p.p_jump
		if p.g then
			sfx(3,3)
			p.dy = -gravity
		end

	end
	
	
	if up == true then
		animate(33,38,0.2)
	end
	
	
--wall jump -----------
	local wall_dir = 0
 if up and col(p.x+8, p.y+7) then
    wall_dir = 1
 elseif up and col(p.x-0.8, p.y+7) then
    wall_dir = -1
 end

 // jump

 // wall jump
 if btnp(⬆️) and (wall_dir != 0) then
 			
    p.dy = -gravity
    p.dx = -wall_dir * 0.8 * 2

 end


	
--idle stance-----------------

	if not btnp(⬆️) and not btnp(🅾️)
	and not (btn(➡️)) and not (btn(⬅️))
 and not land and not up then
		animate(1,6,0.2)
	end
	
--moving speeds----------------
	p.y += p.dy
	p.dx *= 0.8 
	p.dy += 0.09
	cx = 0
	cy = 0
	
	if p.dx > 0 then 
		if not col(p.x+8, p.y+7) then
			p.x += p.dx
		end
	end
	
	if p.dx < 0 then 
		if not col(p.x-1, p.y+7) then
			p.x += p.dx
		end
	end
	
	
--collision checks---------
		if col(p.x,p.y+8)
		or col(p.x+7, p.y+8) then
			if not p.g then
				sfx(4,3)
				land = true
			end
			if land then
				animate(49,54,0.5)
			end
			p.dy = 0 
			p.g = true
		else
			p.g = false
		end
	
		
		
--bump the clipped pixel up---
	if col(p.x,p.y+7)
	and col(p.x+7, p.y+7) then
	p.y -= 1
	end
	
	if col(p.x+7, p.y+7) or
	 col(p.x, p.y+7) then
	p.y -=  1

	end
end


--level restart---------------
function checkbounds()
	if p.y then
		if p.y > level.y + 106 then
			
				p.x = level.x
				p.y = level.y
			
			
			end
	end
end
--draw player on screen-------
function draw_player()
	spr(frame,p.x,p.y,1,1,p.flipped)
end


function animate(start, 
end_frame, speed)
--if impact ground-----------
	if frame == 7 and p.g then
	 sfx(5,3)
	end

--animation------------------
	if frame<start then
	 frame = start
	end
		if frame<end_frame - speed
	 then
			frame+=speed
		else
			frame=start
		end
		
		if frame >= end_frame-speed then
			if land then
				land = false
			end
			if up then 
				up = false
			end
		end
end


