--init file
function _init()
--intro()
	
	poke( 0x5f2e, 1 ) --enable hidden colors
	pal( {[4]=143} ,1 )
	pal( {[2]=141} ,1 )
	poke(0x5f5c,255) --remove repeat buttons
	state = "menu"
	--music(16,0,12)

end

function _update()
	if state == "menu" then
		menu_update()
	end
	
	if state == "game" then
		game_update()
	end
end

function _draw()
	if state == "menu" then
		menu_draw()
	end
	
	if state == "game" then
		game_draw()
	end
end
