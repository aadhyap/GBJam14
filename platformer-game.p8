--menu state

function menu_update()
	if (btnp(❎)) then 
		state ="game"
		game_init()
	end
end
	
function menu_draw()
	--clear screen with blue 
	cls(1)
	--title + shadow
	print("a game!", 51, 48, 0)
	print("a game!", 50, 48, 3)

	--instructions + shadow
	print("press ❎ to play!", 31,
	70,0)
	print("press ❎ to play!", 30,
	72,3)

end
-->8
-- main functions

function game_init()
--location of levels on map
	music(8)
	levels = {
	{0,17,"x1"},
	{18,17,"x2"}
	}
	
--level struct	
	level = {
		x = 0,
		y = 17,
		name = "x1"
	}
	
--level number
	levelnum = 1
	init_player(8,17)
	map_x = 0
	map_y = 17
	
--light vs dark
	light_tile = 81
	dark_tile = 65
	none = 68
	light = true
	init_parallax()
end

function game_update()
		
	update_player()
	update_parallax()
	if btnp(❎) then
	-- switch
		if light then
			set_all1(light_tile,dark_tile)
			light = false
		else
			set_all1(dark_tile,light_tile)
			light = true
		end
	end
	
--camera update-------------
	cx = ((p.x-64)+(cx*9)) /10
	if (cx < 0 ) cx = 0
	
--completed level----------
	if level_finished(p.x+7,p.y) then
		sfx(6)
		next_level()
	end
		
--if player off screen
--reset player
	checkbounds()


end


function game_draw()
	cls()
 rectfill(0,0,128,128,0)
 map(0,0,0,-64,16,16)
 map(0,0,0,64,16,16)
 draw_parallax()
 
	camera(cx,cy)
	map(map_x,map_y)
	draw_player()
	
	if mode=="levelover" then
-- draw_levelover() - dont need
	end
end









-->8
-- player functions

function init_player(srt_x, srt_y)
	p = {
		x =srt_x,
		y =srt_y,
		dx = 0,
		dy = 0,
		g = false,
		flipped = false,
	}
	frame=1
	gravity = 1.5
	black = true
end

function update_player()
--move buttons----------------
	if (btn(⬅️)) or (btn(➡️)) then
		land = false
		if not up then
			animate(7,9,0.2)
		end
		if (btn(⬅️)) then
			p.flipped = true
			p.dx -= 0.2
		else
			p.flipped = false
			p.dx += 0.2
		end
	end
	
	if btnp(⬆️) or btnp(🅾️) then
		up =true
		if p.g then
			sfx(3)
			p.dy = -gravity
		end
	end
	if up == true then
		animate(33,38,0.2)
	end
	
	
	
--idle stance-----------------

	if not btnp(⬆️) and not btnp(🅾️)
	and not (btn(➡️)) and not (btn(⬅️))
 and not land and not up then
		animate(1,6,0.2)
	end
	
--moving speeds----------------
	p.y += p.dy
	p.dx *= 0.8 
	p.dy += 0.09
	cx = 0
	cy = 0
	
	if p.dx > 0 then 
		if not col(p.x+8, p.y+7) then
			p.x += p.dx
		end
	end
	
	if p.dx < 0 then 
		if not col(p.x-1, p.y+7) then
			p.x += p.dx
		end
	end
		
--collision checks---------
		if col(p.x,p.y+8)
		or col(p.x+7, p.y+8) then
			if not p.g then
				sfx(4)
				land = true
			end
			if land then
				animate(49,54,0.5)
			end
			p.dy = 0 
			p.g = true
		else
			p.g = false
		end
	
		
		
--bump the clipped pixel up---
	if col(p.x,p.y+7)
	and col(p.x+7, p.y+7) then
	p.y -= 1
	end
	
	if col(p.x+7, p.y+7) then
	p.x -= 1
	end
	
	if col(p.x, p.y+7) then
	p.x +=  1
	end
end


--level restart---------------
function checkbounds()
	if p.x > level.x + 106 or 
		p.y > level.y + 106 then
		
			p.x = level.x
			p.y = level.y
		
		
		end
end
--draw player on screen-------
function draw_player()
	spr(frame,p.x,p.y,1,1,p.flipped)
end


function animate(start, 
end_frame, speed)
--if impact ground-----------
	if frame == 7 and p.g then
	 sfx(5)
	end

--animation------------------
	if frame<start then
	 frame = start
	end
		if frame<end_frame - speed
	 then
			frame+=speed
		else
			frame=start
		end
		
		if frame >= end_frame-speed then
			if land then
				land = false
			end
			if up then 
				up = false
			end
		end
end


-->8
--game helper

function draw_gamveover()
	rectfill(0,60,128,75,0)
	print("game over", 46, 62,7)
	print("press ❎ to restart", 27)
end

function draw_levelover()
	rectfill(0,60,128,75,0)
	print("stage clear", 46, 62,7)
	print("press ❎ to continue",27,68,6)
	
end

function next_level()

	levelnum +=1
	if levelnum > 2 then
	-- endgame 
	else
--update to next level------
		sfx(6)
		level.x = levels[levelnum][1]
		level.y = levels[levelnum][2]
		level.name = levels[levelnum][3]
		
		p.x = level.x
		p.y = level.y
		map_x = level.x
		map_y = level.y
	end
end

--collision checks----------
function col(x,y)
		return fget(
			mget(map_x + x/8, map_y + y/8),0
		) 
end

--level finished flag check---
function level_finished(x,y)

	return fget(
		mget(map_x + x/8, map_y + y/8),2
	)
end

function set_all1(old,new)
	for y = level.y,level.y +15 do
  for x = level.x,level.x+15 do
   if mget(x,y) == none then
      mset(x,y,new) 
   end
   
   if mget(x,y) == old then
      mset(x,y,none)
   end 
  end
	end
end



