--menu state

function menu_update()
	
	if (btnp(❎)) then 
		state ="game"
		game_init()
	end
end
	
function menu_draw()
--clear screen with blue 
cls(1)

--title + shadow
print("a game!", 51, 48, 0)
print("a game!", 50, 48, 3)


--instructions + shadow
print("press ❎ to play!", 31,
70,0)
print("press ❎ to play!", 30,
72,3)

end
-->8
-- main functions

function game_init()

--location of levels on map
	levels = {
	{0,0,"x1"},
	{21,0,"x2"}
	}
	
--level struct	
	level = {
		x = 0,
		y = 0,
		name = "x1"
	}
	
--level number
	levelnum = 1
	init_player(42,60)
	map_x = 0
	map_y = 0
	
end

function game_update()
		
		update_player()
		
--camer update-------------
		cx = ((p.x-64)+(cx*9)) /10
		if (cx < 0 ) cx = 0
		
--completed level----------
		if level_finished(p.x+7,p.y) then
			next_level()
		end
end


function game_draw()
	cls()
	camera(cx,cy)
	map(map_x,map_y)
	draw_player()
	if mode=="levelover" then
-- draw_levelover() - dont need
	end
end

--collision checks----------
function col(x,y)
		return fget(
			mget(map_x + x/8, map_y + y/8),0
		)
end

--level finished flag check---
function level_finished(x,y)
	return fget(
		mget(x/8, y/8),1
	)
end






-->8
-- player functions

function init_player(srt_x, srt_y)
	p = {
		x =srt_x,
		y =srt_y,
		dx = 0,
		dy = 0,
		g = false,
		flipped = false,
	}
	frame=1
	gravity = 1.3
end

function update_player()
--move buttons----------------
	if (btn(⬅️)) or (btn(➡️)) then
		land = false
		if not up then
			animate(7,9,0.2)
		end
		if (btn(⬅️)) then
			p.flipped = true
			p.dx -= 0.2
		else
			p.flipped = false
			p.dx += 0.2
		end
	end
	

	if btnp(⬆️) or btnp(🅾️) then
		up =true
		if p.g then
			sfx(3)
			p.dy = -gravity
		end
	end
	if up == true then
		animate(33,38,0.2)
	end
	
--idle stance-----------------

	if not btnp(⬆️) and not btnp(🅾️)
	and not (btn(➡️)) and not (btn(⬅️))
 and not land and not up then
		animate(1,6,0.2)
	end
	
--moving speeds----------------
	p.y += p.dy
	p.dx *= 0.8 
	p.dy += 0.09
	cx = 0
	cy = 0
	
	if p.dx > 0 then 
		if not col(p.x+8, p.y+7) then
			p.x += p.dx
		end
	end
	
	if p.dx < 0 then 
		if not col(p.x-1, p.y+7) then
			p.x += p.dx
		end
	end
		
--collision checks---------
		if col(p.x,p.y+8)
		or col(p.x+7, p.y+8) then
			if not p.g then
				sfx(4)
				land = true
			end
			if land then
				animate(49,54,0.5)
			end
			p.dy = 0 
			p.g = true
		else
			p.g = false
		end
	
		
		
--bump the clipped pixel up---
	if col(p.x,p.y+7)
	and col(p.x+7, p.y+7) then
	p.y -= 1
	end
	
	if col(p.x+7, p.y+7) then
	p.x -= 1
	end
	
	if col(p.x, p.y+7) then
	p.x +=  1
	end
end

--draw player on screen-------
function draw_player()
	spr(frame,p.x,p.y,1,1,p.flipped)
end


function animate(start, 
end_frame, speed)
--if impact ground-----------
	if frame == 7 and p.g then
	 sfx(5)
	end

--animation------------------
	if frame<start then
	 frame = start
	end
		if frame<end_frame - speed
	 then
			frame+=speed
		else
			frame=start
		end
		
		if frame >= end_frame-speed then
			if land then
				land = false
			end
			if up then 
				up = false
			end
		end
end


